        ADD["B. Add liquidity<br/>LP minted to the depositor"]
        SWAP["C. Swap<br/>one pool, one action"]
        ROUTE["D. Route<br/>several pools, one bundle"]
        REMOVE["E. Remove<br/>LP burned, reserves paid pro-rata"]
        OPS["F. Operator lanes<br/>collect, observe, dao_fee"]
